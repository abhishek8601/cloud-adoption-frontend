{
  "expo": {
    "name": "CloudAdoptionConferenceApp",
    "slug": "CloudAdoptionConferenceApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "cloudadoptionconferenceapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lifesciencesdreamin.conference",
      "icon": "./assets/expo.icon",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.lifesciencesdreamin.conference",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Container.png",
        "backgroundImage": "./assets/images/Container.png",
        "monochromeImage": "./assets/images/Container.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo White.png",
          "imageWidth": 88
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-image",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
